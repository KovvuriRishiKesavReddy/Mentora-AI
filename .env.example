# Copy this file to .env and fill in your key. .env is never shipped or committed.
GROQ_API_KEY=
# Models (must exist on your Groq account; change here if Groq retires one)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
# Browser origins allowed to call the API (comma separated). Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Speech-to-text: browser (default, Chrome/Edge Web Speech API) | groq (server-side Whisper, audio goes to Groq) | none
STT_PROVIDER=browser
# gpt-oss reasoning depth: low (fast) | medium | high
# REASONING_EFFORT=low
# Optional tuning
# MAX_UPLOAD_MB=25
# MAX_AUDIO_MB=10
# MAX_AUDIO_SECONDS=60
# RAG_SIM_WEAK=0.25
# RAG_SIM_STRONG=0.40
# MENTORA_DATA_DIR=./data
# Study tools (summary / flashcards)
# SUMMARY_PIECE_CHARS=6000
# SUMMARY_MAX_CALLS=40
# FLASHCARD_MAX=20
